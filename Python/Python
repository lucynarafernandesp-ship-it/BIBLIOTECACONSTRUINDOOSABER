"""

@app.route("/")
def index():
    total = sum(item["preco"] for item in carrinho)
    return render_template_string(HTML_TEMPLATE, livros=LIVROS, carrinho=carrinho, total=total)

@app.route("/add/<int:livro_id>/<tipo>")
def add_carrinho(livro_id, tipo):
    livro = next((l for l in LIVROS if l["id"] == livro_id), None)
    if livro:
        preco = livro["venda"] if tipo == "Venda" else livro["aluguel"]
        carrinho.append({"titulo": livro["titulo"], "tipo": tipo, "preco": preco})
    return redirect(url_for("index"))

@app.route("/checkout", methods=["POST"])
def checkout():
    carrinho.clear()
    return "<h1>✅ Pedido Finalizado com Sucesso!</h1><a href='/'>Voltar à Loja</a>"

if __name__ == "__main__":
    app.run(debug=True)
